{
  "name": "penciled-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter penciled build",
    "dev": "pnpm --filter penciled dev",
    "playground": "pnpm --filter penciled playground",
    "docs:dev": "pnpm build && pnpm --filter docs dev",
    "docs:build": "pnpm build && pnpm --filter docs build",
    "ext:dev": "pnpm build && pnpm --filter extension dev",
    "ext:build": "pnpm build && pnpm --filter extension build",
    "ext:zip": "pnpm build && pnpm --filter extension zip",
    "test": "pnpm --filter penciled test",
    "test:e2e": "pnpm --filter penciled test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "pnpm --filter penciled size",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "bench": "pnpm --filter penciled bench"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3"
  }
}
