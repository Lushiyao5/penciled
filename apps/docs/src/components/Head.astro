---
// Starlight's head with descriptive titles and structured data, plus Vercel Web Analytics
// (cookieless, so no consent banner).
import Default from '@astrojs/starlight/components/Head.astro';
import Analytics from '@vercel/analytics/astro';

const route = Astro.locals.starlightRoute;
const { data } = route.entry;

if (data.metaTitle) {
  for (const tag of route.head) {
    if (tag.tag === 'title') tag.content = `${data.metaTitle} | penciled`;
    else if (tag.attrs?.property === 'og:title' || tag.attrs?.name === 'twitter:title') {
      tag.attrs.content = data.metaTitle;
    }
  }
}

const url = Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const home = Astro.site && new URL('/', Astro.site).href;
const structuredData = url &&
  home && [
    {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: data.metaTitle ?? data.title,
      description: data.description,
      url,
      inLanguage: 'en',
      ...(route.lastUpdated && { dateModified: route.lastUpdated.toISOString() }),
      author: { '@type': 'Person', name: 'Marcel Losso', url: 'https://github.com/marcellosso' },
      about: { '@type': 'SoftwareApplication', name: 'penciled.js', url: home },
      isPartOf: { '@type': 'WebSite', name: 'penciled.js', url: home },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'penciled.js', item: home },
        { '@type': 'ListItem', position: 2, name: data.title, item: url },
      ],
    },
  ];
---

<Default />
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
<Analytics />
